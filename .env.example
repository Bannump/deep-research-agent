# API
API_HOST=0.0.0.0
API_PORT=8000

# Pipeline (defaults match assessment spec)
WORKING_MEMORY_TOKEN_BUDGET=2000

# LLM: mock | openai | anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Cost model (USD per 1k tokens, approximate)
DEFAULT_COST_PER_1K_TOKENS_USD=0.002

# Storage (defaults relative to project / set explicitly in Docker)
# DATA_DIR=./data
# CHROMA_PATH=./data/chroma_db
# SQLITE_PATH=./data/sessions.db
# SAMPLE_DOCS_DIR=./data/sample_docs

# Chunking
CHUNK_SIZE_CHARS=900
CHUNK_OVERLAP_CHARS=120

# Tests / CI: set to 1 for deterministic embeddings
# USE_MOCK_EMBEDDINGS=0

# n8n (docker-compose)
N8N_PORT=5678
N8N_HOST=localhost
